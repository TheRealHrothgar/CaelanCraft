{
  "name": "caelancraft",
  "version": "0.3.0",
  "description": "Caelancraft — a honeycomb voxel sandbox of hexagonal prisms that runs in the browser",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests *.config.js",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run test && npm run build",
    "smoke:win": "bash scripts/smoke-windows-chrome.sh"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
